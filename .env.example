# VaultKeep Environment Variables & Secrets Configuration Example
# Copy this file to '.env' or '.env.local' for local build configurations.
# DO NOT commit '.env' or any files containing actual secret credentials to source control.

# ==========================================
# 1. AI Studio & Gemini API Configuration
# ==========================================
# GEMINI_API_KEY: Used for Google AI Studio / Gemini service integrations.
# When provided, Secrets Gradle Plugin will map this to BuildConfig.GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Firebase & AppCheck Configuration
# ==========================================
# FIREBASE_APPCHECK_DEBUG_TOKEN: Debug token used during local AppCheck testing.
FIREBASE_APPCHECK_DEBUG_TOKEN=your_firebase_appcheck_debug_token_here

# ==========================================
# 3. Android Application Release Signing Credentials
# ==========================================
# KEYSTORE_PATH: Path to the release upload JKS keystore file.
KEYSTORE_PATH=/path/to/release.keystore

# STORE_PASSWORD: KeyStore password.
STORE_PASSWORD=your_store_password_here

# KEY_ALIAS: Key alias name inside the KeyStore.
KEY_ALIAS=vaultkeep

# KEY_PASSWORD: Password for the key alias.
KEY_PASSWORD=your_key_password_here
